					mhi,data-type = <0x00>;
					mhi,doorbell-mode = <0x02>;
					mhi,ee = <0x14>;
					mhi,event-ring = <0x01>;
					mhi,num-elements = <0x20>;
					reg = <0x00>;
				};

				mhi_chan@1 {
					label = "LOOPBACK";
					mhi,chan-dir = <0x02>;
					mhi,data-type = <0x00>;
					mhi,doorbell-mode = <0x02>;
					mhi,ee = <0x14>;
					mhi,event-ring = <0x01>;
					mhi,num-elements = <0x20>;
					reg = <0x01>;
				};

				mhi_chan@4 {
					label = "DIAG";
					mhi,chan-dir = <0x01>;
					mhi,data-type = <0x00>;
					mhi,doorbell-mode = <0x02>;
					mhi,ee = <0x14>;
					mhi,event-ring = <0x01>;
					mhi,num-elements = <0x20>;
					reg = <0x04>;
				};

				mhi_chan@5 {
					label = "DIAG";
					mhi,chan-dir = <0x02>;
					mhi,data-type = <0x00>;
					mhi,doorbell-mode = <0x02>;
					mhi,ee = <0x14>;
					mhi,event-ring = <0x01>;
					mhi,num-elements = <0x20>;
					reg = <0x05>;
				};

				mhi_chan@20 {
					label = "IPCR";
					mhi,auto-start;
					mhi,chan-dir = <0x01>;
					mhi,data-type = <0x01>;
					mhi,doorbell-mode = <0x02>;
					mhi,ee = <0x14>;
					mhi,event-ring = <0x01>;
					mhi,num-elements = <0x20>;
					reg = <0x14>;
				};

				mhi_chan@21 {
					label = "IPCR";
					mhi,auto-queue;
					mhi,auto-start;
					mhi,chan-dir = <0x02>;
					mhi,data-type = <0x00>;
					mhi,doorbell-mode = <0x02>;
					mhi,ee = <0x14>;
					mhi,event-ring = <0x01>;
					mhi,num-elements = <0x20>;
					reg = <0x15>;
				};
