		onewire_gpio {
			compatible = "xiaomi,onewire_gpio";
			label = "xm_onewire";
			mi,onewire-gpio-cfg-addr = <0xf519000 0x04>;
			pinctrl-0 = <0xa2>;
			pinctrl-1 = <0xa3>;
			pinctrl-names = "onewire_active", "onewire_sleep";
			status = "ok";
			xiaomi,gpio_number = <0x19>;
			xiaomi,ow_gpio = <0xffffffff 0x19 0x00>;
			xiaomi,version = <0x01>;
		};

		qcom,camera-flash@0 {
			cell-index = <0x00>;
			compatible = "qcom,camera-flash";
			flash-source = <0xab>;
			status = "ok";
			switch-source = <0xad>;
			torch-source = <0xac>;
		};

		qcom,camera-flash@1 {
			cell-index = <0x01>;
			compatible = "qcom,camera-flash";
			flash-source = <0xab>;
			status = "ok";
			switch-source = <0xad>;
			torch-source = <0xac>;
		};

		qcom,camera-flash@2 {
			cell-index = <0x02>;
			compatible = "qcom,camera-flash";
			flash-source = <0xab>;
			status = "ok";
			switch-source = <0xad>;
			torch-source = <0xac>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	chosen {
		bootargs = "quiet noirqdebug nodebugmon rcupdate.rcu_expedited=1 rcu_nocbs=0-7 kpti=off cgroup_disable=pressure";
	};

	firmware {

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo";
			};

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/1d84000.ufshc/by-name/vendor";
					fsmgr_flags = "wait,avb";
					mnt_flags = "ro,barrier=1,discard";
					status = "ok";
					type = "ext4";
				};
			};
		};
	};

