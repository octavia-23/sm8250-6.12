			compatible = "qcom,pci-msm";
			dma-coherent;
			gdsc-vdd-supply = <0x16c>;
			interrupt-map = <
        0x0 0x0 0x0 0x0 0x1 0x0 0x8c 0x4
        0x0 0x0 0x0 0x1 0x1 0x0 0x95 0x4
        0x0 0x0 0x0 0x2 0x1 0x0 0x96 0x4
        0x0 0x0 0x0 0x3 0x1 0x0 0x97 0x4
        0x0 0x0 0x0 0x4 0x1 0x0 0x98 0x4
    >;
