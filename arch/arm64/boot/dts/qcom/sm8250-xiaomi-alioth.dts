		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0d>;
				};

				core1 {
					cpu = <0x0e>;
				};

				core2 {
					cpu = <0x0f>;
				};

				core3 {
					cpu = <0x10>;
				};

				core4 {
					cpu = <0x11>;
				};

				core5 {
					cpu = <0x12>;
				};

				core6 {
					cpu = <0x13>;
				};

				core7 {
					cpu = <0x14>;
				};
			};
		};
