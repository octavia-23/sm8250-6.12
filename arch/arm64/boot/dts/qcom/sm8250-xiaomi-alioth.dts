		cpu@700 {
			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x400>;
			compatible = "qcom,kryo";
			cpu-release-addr = <0x00 0x90000000>;
			device_type = "cpu";
			dynamic-power-coefficient = <0x182>;
			enable-method = "psci";
			next-level-cache = <0x0c>;
