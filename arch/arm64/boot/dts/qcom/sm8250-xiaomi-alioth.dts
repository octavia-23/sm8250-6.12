			qcom,vdd_cx-uV-uA = <0x180 0x00>;
			qcom,vdd_mx-uV-uA = <0x180 0x00>;
			reg = <0x5c00000 0x4000>;
			status = "ok";
			vdd_cx-supply = <0x93>;
			vdd_mx-supply = <0x94>;
