		rsc@af20000 {
			compatible = "qcom,rpmh-rsc";
			interrupts = <0x00 0x81 0x04>;
			label = "disp_rsc";
			qcom,drv-id = <0x00>;
			qcom,tcs-config = <0x02 0x00 0x00 0x01 0x01 0x01 0x03 0x00>;
			qcom,tcs-offset = <0x1c00>;
			reg = <0xaf20000 0x10000>;
			reg-names = "drv-0";

			msm_bus_disp_rsc {
				compatible = "qcom,msm-bus-rsc";
				qcom,msm-bus-id = <0x1f41>;
			};

			sde_rsc_rpmh {
				cell-index = <0x00>;
				compatible = "qcom,sde-rsc-rpmh";
			};
		};

		syscon@1f40000 {
			compatible = "syscon";
			reg = <0x1f40000 0x20000>;
		};

		hwlock {
			#hwlock-cells = <0x01>;
			compatible = "qcom,tcsr-mutex";
			syscon = <0x83 0x00 0x1000>;
		};

		qcom,smem {
			compatible = "qcom,smem";
			hwlocks = <0x85 0x03>;
			memory-region = <0x84>;
		};

		kryo-erp {
			compatible = "arm,arm64-kryo-cpu-erp";
			interrupt-names = "l1-l2-faultirq", "l3-scu-faultirq";
			interrupts = <0x01 0x00 0x04 0x00 0x23 0x04>;
		};

		mailbox@188501c {
			#mbox-cells = <0x01>;
			compatible = "qcom,kona-spcs-global";
			reg = <0x188501c 0x04>;
		};

		syscon@1880000 {
			compatible = "syscon";
			reg = <0x1880000 0x10000>;
		};

		qcom,qsee_irq {
			#interrupt-cells = <0x03>;
			compatible = "qcom,kona-qsee-irq";
			interrupt-controller;
			interrupt-names = "sp_ipc0", "sp_ipc1";
			interrupts = <0x00 0x15c 0x04 0x00 0x15d 0x04>;
			syscon = <0x86>;
		};

		qcom,qsee_irq_bridge {
			compatible = "qcom,qsee-ipc-irq-bridge";

			qcom,qsee-ipc-irq-spss {
				interrupt-parent = <0x87>;
				interrupts = <0x01 0x00 0x04>;
				label = "spss";
				qcom,dev-name = "qsee_ipc_irq_spss";
			};
		};

