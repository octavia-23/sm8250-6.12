		pil_slpi: qcom,ssc@5c00000 {
			clock-names = "xo";
			clocks = <0x15 0x00>;
			compatible = "qcom,pil-tz-generic";
			interrupt-names = "qcom,wdog", "qcom,err-fatal", "qcom,proxy-unvote", "qcom,err-ready", "qcom,stop-ack";
			interrupts-extended = <0x74 0x09 0x04 0xa5 0x00 0x00 0xa5 0x02 0x00 0xa5 0x01 0x00 0xa5 0x03 0x00>;
			mbox-names = "slpi-pil";
			mboxes = <0x02 0x00>;
			memory-region = <0xa4>;
			qcom,complete-ramdump;
			qcom,firmware-name = "slpi";
			qcom,pas-id = <0x0c>;
			qcom,proxy-clock-names = "xo";
			qcom,proxy-reg-names = "vdd_cx", "vdd_mx";
			qcom,proxy-timeout-ms = <0x2710>;
			qcom,signal-aop;
			qcom,smem-id = <0x1a8>;
			qcom,smem-state-names = "qcom,force-stop";
			qcom,smem-states = <0xa6 0x00>;
			qcom,ssctl-instance-id = <0x16>;
