	cpu-pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x07 0x04>;
		qcom,irq-is-percpu;
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0xffffffff>;

		qcom,cpufreq-hw {
			#freq-domain-cells = <0x02>;
			clock-names = "xo", "alternate";
			clocks = <0x15 0x00 0x16 0xd1>;
			compatible = "qcom,cpufreq-hw-epss";
			interrupt-names = "dcvsh0_int", "dcvsh1_int", "dcvsh2_int";
			interrupts = <0x00 0x1e 0x04 0x00 0x1f 0x04 0x00 0x13 0x04>;
			qcom,cpufreq-table-0 = <0x11df00 0x130b00 0x148200 0x15ae00 0x172500 0x189c00 0x1a1300 0x1b8a00>;
			qcom,cpufreq-table-1 = <
        0xc9900 0xe5b00 0x101d00 0x11df00 0x13a100 0x151800 0x168f00 0x180600
        0x197d00 0x1af400 0x1c6b00 0x1de200 0x1f5900 0x20d000 0x224700 0x23be00
        0x24ea00
    >;
			qcom,cpufreq-table-2 = <
        0xce400 0xea600 0x106800 0x122a00 0x13ec00 0x156300 0x172500 0x18e700
        0x1aa900 0x1c6b00 0x1e2d00 0x1fa400 0x211b00 0x229200 0x240900 0x258000
        0x26f700 0x286e00 0x29e500 0x2b5c00 0x30a200
    >;
			qcom,lut-row-size = <0x04>;
			qcom,skip-enable-check;
			reg = <0x18591000 0x1000 0x18592000 0x1000 0x18593000 0x1000>;
			reg-names = "freq-domain0", "freq-domain1", "freq-domain2";

			cpu7-notify {
				#cooling-cells = <0x02>;
				qcom,cooling-cpu = <0x14>;
			};

			qcom,cpu-isolation {
				compatible = "qcom,cpu-isolate";

				cpu0-isolate {
					#cooling-cells = <0x02>;
					qcom,cpu = <0x0d>;
				};

				cpu1-isolate {
					#cooling-cells = <0x02>;
					qcom,cpu = <0x0e>;
				};

				cpu2-isolate {
					#cooling-cells = <0x02>;
					qcom,cpu = <0x0f>;
				};

				cpu3-isolate {
					#cooling-cells = <0x02>;
					qcom,cpu = <0x10>;
				};

				cpu4-isolate {
					#cooling-cells = <0x02>;
					qcom,cpu = <0x11>;
				};

				cpu5-isolate {
					#cooling-cells = <0x02>;
					qcom,cpu = <0x12>;
				};

				cpu6-isolate {
					#cooling-cells = <0x02>;
					qcom,cpu = <0x13>;
				};

				cpu7-isolate {
					#cooling-cells = <0x02>;
					qcom,cpu = <0x14>;
				};
			};

			qcom,limits-dcvs {
				compatible = "qcom,msm-hw-limits";
				isens-vref-0p8-settings = <0xd6d80 0xd6d80 0x4e20>;
				isens-vref-1p8-settings = <0x1b7740 0x1b7740 0x4e20>;
				isens_vref_0p8-supply = <0x17>;
				isens_vref_1p8-supply = <0x18>;
			};
		};

		thermal-zones {

			aoss0-usr {
				polling-delay = <0x00>;
				polling-delay-passive = <0x00>;
				thermal-governor = "user_space";
				thermal-sensors = <0x19 0x00>;
				wake-capable-sensor;

				trips {

